{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ensure-feature-branch.sh",
            "filter": "git (commit|push|rebase|merge|cherry-pick|switch|checkout|branch)"
          }
        ]
      }
    ]
  }
}
