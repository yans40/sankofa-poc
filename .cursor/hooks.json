{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/ensure-feature-branch.sh",
        "matcher": "git\\s+(commit|push|rebase|merge|cherry-pick|switch|checkout)",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/ensure-branch-up-to-date.sh",
        "matcher": "git\\s+push|gh\\s+pr\\s+create",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/route-to-qa.sh",
        "matcher": "gh\\s+pr\\s+create|gh\\s+pr\\s+view|git\\s+push",
        "failClosed": false
      }
    ]
  }
}
